<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#7c3aed">
<title>Lanks Absen</title>
<style>
:root {
  color-scheme: dark;
  --bg: #100b1d;
  --panel: #1d1430;
  --line: #49316b;
  --purple: #7c3aed;
  --text: #f5f3ff;
  --muted: #c4b5fd;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  min-height: 100vh;
  background: radial-gradient(ellipse at top,#35145e,#100b1d 70%);
  color: var(--text);
  font: 15px system-ui,Arial,sans-serif;
}
main { max-width: 560px; margin: auto; padding: 22px 15px 40px; }
header { text-align: center; padding: 16px 0 22px; }
.logo {
  display: inline-grid;
  place-items: center;
  width: 62px;
  height: 62px;
  border-radius: 20px;
  background: var(--purple);
  font-size: 30px;
}
h1 { font-size: 27px; margin: 12px 0 5px; }
p { color: var(--muted); line-height: 1.5; }
.card {
  background: #1d1430ee;
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 17px;
  margin: 14px 0;
}
label { display: block; margin: 13px 0 6px; color: var(--muted); }
input, select, button { font: inherit; }
input, select {
  width: 100%;
  padding: 12px;
  border-radius: 10px;
  border: 1px solid var(--line);
  background: var(--bg);
  color: white;
}
button {
  border: 0;
  border-radius: 10px;
  padding: 12px;
  background: var(--purple);
  color: white;
  font-weight: 700;
  cursor: pointer;
}
button:disabled { opacity: .6; cursor: wait; }
.wide { width: 100%; margin-top: 12px; }
.secondary { background: #332347; border: 1px solid var(--line); }
.tabs { display: flex; gap: 8px; }
.tabs button { flex: 1; }
.hidden { display: none !important; }
.msg {
  padding: 11px;
  border-radius: 10px;
  margin-top: 12px;
  background: #302044;
  overflow-wrap: anywhere;
}
.error { color: #fca5a5; }
.ok { color: #86efac; }
.small { font-size: 12px; color: var(--muted); }
.topline { display:flex; justify-content:space-between; gap:8px; align-items:center; }
.pill { font-size: 11px; color: var(--muted); overflow-wrap:anywhere; }
img { width:100%; max-height:280px; object-fit:contain; margin-top:10px; }
footer { text-align:center; color:#a78bfa; font-size:12px; margin-top:24px; }
</style>
</head>
<body>
<main>
<header>
  <div class="logo">✓</div>
  <h1>Lanks Absen</h1>
  <p>Absensi digital • Cepat • Praktis</p>
</header>

<section class="card" id="authCard">
  <div class="tabs">
    <button id="tabLogin" type="button">Login</button>
    <button id="tabRegister" class="secondary" type="button">Daftar</button>
  </div>

  <form id="authForm">
    <label for="email">Email</label>
    <input id="email" type="email" required autocomplete="email"
      placeholder="nama@gmail.com">

    <label for="password">Kata sandi</label>
    <input id="password" type="password" required minlength="6"
      autocomplete="current-password" placeholder="Minimal 6 karakter">

    <button class="wide" id="authSubmit" type="submit">Login</button>
  </form>

  <button class="wide secondary" id="resetBtn" type="button">
    Reset kata sandi
  </button>
  <div id="authMsg" class="msg hidden"></div>
  <p class="small">Jika pendaftaran meminta verifikasi, periksa email dan folder Spam.</p>
</section>

<section class="card hidden" id="appCard">
  <div class="topline">
    <h3>Absensi Hari Ini</h3>
    <span class="pill" id="userPill"></span>
  </div>

  <p id="dateText"></p>

  <label for="fullName">Nama lengkap</label>
  <input id="fullName" maxlength="80" placeholder="Nama kamu" required>

  <label for="age">Umur member (tahun)</label>
  <input id="age" type="number" min="1" max="120" step="1"
    inputmode="numeric" placeholder="Contoh: 20" required>

  <label for="asalKota">Asal kota</label>
  <input id="asalKota" type="text" maxlength="100"
    placeholder="Contoh: Banjarmasin" autocomplete="address-level2" required>

  <label for="jenisKelamin">Jenis kelamin</label>
  <select id="jenisKelamin" required>
    <option value="">-- Pilih jenis kelamin --</option>
    <option value="Laki-laki">Laki-laki</option>
    <option value="Perempuan">Perempuan</option>
  </select>

  <label for="kind">Jenis absensi</label>
  <select id="kind" required>
    <option value="Masuk">Masuk</option>
    <option value="Pulang">Pulang</option>
  </select>

  <label for="photo">Foto bukti absensi</label>
  <input id="photo" type="file" accept="image/*" capture="user">
  <img id="preview" class="hidden" alt="Pratinjau foto">

  <button id="submitAttendance" class="wide" type="button">Simpan Absensi</button>
  <div id="attMsg" class="msg hidden"></div>

  <button id="historyBtn" class="wide secondary" type="button">Lihat Riwayat</button>
  <div id="history" class="small"></div>

  <button id="logoutBtn" class="wide secondary" type="button">Keluar</button>
</section>

<footer>Lanks Absen • Data disimpan melalui Supabase</footer>
</main>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
const SUPABASE_URL = 'https://qwxcpbnpzbjayojrtfum.supabase.co';
const SUPABASE_KEY = 'sb_publishable_SrZiE_28t7etIKjvZNHQBA_W37RFM5f';

const $ = id => document.getElementById(id);
const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

let mode = 'login';
let currentUser = null;

function message(id, text, type = '') {
  const el = $(id);
  el.textContent = text;
  el.className = 'msg' + (type ? ' ' + type : '');
  el.classList.remove('hidden');
}

function hide(id) {
  $(id).classList.add('hidden');
}

function render() {
  const loggedIn = !!currentUser;
  $('authCard').classList.toggle('hidden', loggedIn);
  $('appCard').classList.toggle('hidden', !loggedIn);

  if (loggedIn) {
    $('userPill').textContent = currentUser.email || '';
    $('dateText').textContent = new Date().toLocaleString('id-ID', {
      dateStyle: 'full',
      timeStyle: 'short'
    });
  }
}

function setMode(value) {
  mode = value;
  $('tabLogin').className = value === 'login' ? '' : 'secondary';
  $('tabRegister').className = value === 'register' ? '' : 'secondary';
  $('authSubmit').textContent = value === 'login' ? 'Login' : 'Buat akun';
  $('password').autocomplete = value === 'login'
    ? 'current-password'
    : 'new-password';
  hide('authMsg');
}

$('tabLogin').onclick = () => setMode('login');
$('tabRegister').onclick = () => setMode('register');

$('authForm').addEventListener('submit', async event => {
  event.preventDefault();

  const btn = $('authSubmit');
  btn.disabled = true;
  hide('authMsg');

  try {
    const email = $('email').value.trim();
    const password = $('password').value;
    let result;

    if (mode === 'register') {
      result = await sb.auth.signUp({ email, password });
      if (result.error) throw result.error;

      if (result.data.session) {
        currentUser = result.data.session.user;
        render();
        message('attMsg', 'Pendaftaran berhasil. Silakan isi data absensi.', 'ok');
      } else {
        message(
          'authMsg',
          'Pendaftaran berhasil. Periksa email untuk verifikasi sebelum login.',
          'ok'
        );
      }
    } else {
      result = await sb.auth.signInWithPassword({ email, password });
      if (result.error) throw result.error;

      currentUser = result.data.user;
      render();
      await loadHistory();
    }
  } catch (error) {
    message('authMsg', error.message || 'Login gagal.', 'error');
  } finally {
    btn.disabled = false;
  }
});

$('resetBtn').onclick = async () => {
  const email = $('email').value.trim();

  if (!email) {
    message('authMsg', 'Masukkan email terlebih dahulu.', 'error');
    return;
  }

  try {
    const { error } = await sb.auth.resetPasswordForEmail(email);
    if (error) throw error;
    message('authMsg', 'Jika email terdaftar, tautan reset akan dikirim.', 'ok');
  } catch (error) {
    message('authMsg', error.message, 'error');
  }
};

$('photo').onchange = () => {
  const file = $('photo').files[0];

  if (!file) {
    hide('preview');
    return;
  }

  if (!file.type.startsWith('image/') || file.size > 5 * 1024 * 1024) {
    message('attMsg', 'Pilih foto dengan ukuran maksimal 5 MB.', 'error');
    $('photo').value = '';
    hide('preview');
    return;
  }

  $('preview').src = URL.createObjectURL(file);
  $('preview').classList.remove('hidden');
};

$('submitAttendance').onclick = async () => {
  if (!currentUser) return;

  const nama = $('fullName').value.trim();
  const umurText = $('age').value.trim();
  const umur = Number(umurText);
  const asalKota = $('asalKota').value.trim();
  const jenisKelamin = $('jenisKelamin').value;
  const jenis = $('kind').value;
  const file = $('photo').files[0];

  if (!nama) {
    message('attMsg', 'Isi nama lengkap terlebih dahulu.', 'error');
    return;
  }

  if (umurText === '' || !Number.isInteger(umur) || umur < 1 || umur > 120) {
    message('attMsg', 'Masukkan umur antara 1–120 tahun.', 'error');
    return;
  }

  if (!asalKota) {
    message('attMsg', 'Isi asal kota terlebih dahulu.', 'error');
    return;
  }

  if (!jenisKelamin) {
    message('attMsg', 'Pilih jenis kelamin terlebih dahulu.', 'error');
    return;
  }

  if (!file) {
    message('attMsg', 'Ambil atau pilih foto absensi dahulu.', 'error');
    return;
  }

  if (!file.type.startsWith('image/') || file.size > 5 * 1024 * 1024) {
    message('attMsg', 'Foto harus berupa gambar maksimal 5 MB.', 'error');
    return;
  }

  const btn = $('submitAttendance');
  btn.disabled = true;
  hide('attMsg');

  try {
    const ext = (file.name.split('.').pop() || 'jpg')
      .toLowerCase()
      .replace(/[^a-z0-9]/g, '') || 'jpg';

    const path = currentUser.id + '/' + Date.now() + '.' + ext;

    const upload = await sb.storage.from('foto-absensi').upload(path, file, {
      contentType: file.type,
      upsert: false
    });

    if (upload.error) throw upload.error;

    const { data: publicData } = sb.storage
      .from('foto-absensi')
      .getPublicUrl(path);

    const { error } = await sb.from('absensi').insert({
      user_id: currentUser.id,
      nama: nama,
      umur: umur,
      asal_kota: asalKota,
      jenis_kelamin: jenisKelamin,
      jenis: jenis,
      waktu: new Date().toISOString(),
      foto_url: publicData.publicUrl
    });

    if (error) throw error;

    message('attMsg', 'Absensi berhasil disimpan.', 'ok');
    $('photo').value = '';
    hide('preview');
    await loadHistory();
  } catch (error) {
    message(
      'attMsg',
      'Gagal menyimpan absensi: ' + error.message +
      '. Periksa kolom database, bucket foto-absensi, serta policy Storage/RLS Supabase.',
      'error'
    );
  } finally {
    btn.disabled = false;
  }
};

async function loadHistory() {
  if (!currentUser) return;

  try {
    const { data, error } = await sb.from('absensi')
      .select('nama,umur,asal_kota,jenis_kelamin,jenis,waktu,foto_url')
      .eq('user_id', currentUser.id)
      .order('waktu', { ascending: false })
      .limit(20);

    if (error) throw error;

    const history = $('history');
    history.replaceChildren();

    if (!data || data.length === 0) {
      history.textContent = 'Belum ada riwayat absensi.';
      return;
    }

    data.forEach(row => {
      const item = document.createElement('div');
      item.style.cssText = 'padding:10px 0;border-bottom:1px solid #49316b';

      item.textContent =
        row.nama +
        ' • Umur: ' + (row.umur ?? '-') + ' tahun' +
        ' • Kota: ' + (row.asal_kota || '-') +
        ' • Jenis kelamin: ' + (row.jenis_kelamin || '-') +
        ' • ' + row.jenis +
        ' • ' + new Date(row.waktu).toLocaleString('id-ID');

      if (row.foto_url) {
        const link = document.createElement('a');
        link.href = row.foto_url;
        link.target = '_blank';
        link.rel = 'noopener';
        link.textContent = 'Lihat foto';
        link.style.display = 'block';
        link.style.color = '#c4b5fd';
        item.append(link);
      }

      history.append(item);
    });
  } catch (error) {
    message('attMsg', 'Riwayat gagal dimuat: ' + error.message, 'error');
  }
}

$('historyBtn').onclick = loadHistory;

$('logoutBtn').onclick = async () => {
  const { error } = await sb.auth.signOut();

  if (error) {
    message('attMsg', error.message, 'error');
    return;
  }

  currentUser = null;
  render();
  $('history').replaceChildren();
  $('photo').value = '';
  hide('preview');
  setMode('login');
};

sb.auth.onAuthStateChange((_event, session) => {
  currentUser = session?.user || null;
  render();
});

(async () => {
  const { data, error } = await sb.auth.getSession();

  if (error) {
    message('authMsg', error.message, 'error');
    return;
  }

  currentUser = data.session?.user || null;
  render();

  if (currentUser) await loadHistory();
})();
</script>
</body>
</html>
